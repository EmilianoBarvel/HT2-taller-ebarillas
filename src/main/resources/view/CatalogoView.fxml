<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.auratheria.auratheriaformulario.auratheriagames.controller.CatalogoController"
            stylesheets="@../css/styles.css"
            styleClass="root-pane"
            prefWidth="960.0" prefHeight="640.0">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="12" styleClass="topbar">
            <padding>
                <Insets top="14" right="24" bottom="14" left="24"/>
            </padding>
            <Label text="CATÁLOGO DE VIDEOJUEGOS" styleClass="brand-title-small"/>
            <HBox HBox.hgrow="ALWAYS"/>
            <Button text="&lt; Volver al Menú" onAction="#handleVolver" styleClass="btn-secondary"/>
        </HBox>
    </top>

    <center>
        <VBox spacing="16" styleClass="content-area">
            <padding>
                <Insets top="18" right="24" bottom="18" left="24"/>
            </padding>

            <!-- FORMULARIO -->
            <VBox spacing="10" styleClass="login-card">
                <padding>
                    <Insets top="18" right="18" bottom="18" left="18"/>
                </padding>

                <GridPane hgap="14" vgap="10">
                    <columnConstraints>
                        <ColumnConstraints minWidth="110"/>
                        <ColumnConstraints hgrow="ALWAYS" minWidth="160"/>
                        <ColumnConstraints minWidth="110"/>
                        <ColumnConstraints hgrow="ALWAYS" minWidth="160"/>
                    </columnConstraints>

                    <Label text="Código" styleClass="field-label" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                    <TextField fx:id="txtCodigo" promptText="VG-001"
                               GridPane.columnIndex="1" GridPane.rowIndex="0"/>

                    <Label text="Título" styleClass="field-label" GridPane.columnIndex="2" GridPane.rowIndex="0"/>
                    <TextField fx:id="txtTitulo" promptText="Nombre del videojuego"
                               GridPane.columnIndex="3" GridPane.rowIndex="0"/>

                    <Label text="Plataforma" styleClass="field-label" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                    <ComboBox fx:id="cmbPlataforma" maxWidth="Infinity" editable="true"
                              GridPane.columnIndex="1" GridPane.rowIndex="1"/>

                    <Label text="Categoría" styleClass="field-label" GridPane.columnIndex="2" GridPane.rowIndex="1"/>
                    <ComboBox fx:id="cmbCategoria" maxWidth="Infinity" editable="true"
                              GridPane.columnIndex="3" GridPane.rowIndex="1"/>

                    <Label text="Precio Costo (Q)" styleClass="field-label" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                    <TextField fx:id="txtPrecioCosto" promptText="0.00"
                               GridPane.columnIndex="1" GridPane.rowIndex="2"/>

                    <Label text="Precio Venta (Q)" styleClass="field-label" GridPane.columnIndex="2" GridPane.rowIndex="2"/>
                    <TextField fx:id="txtPrecioVenta" promptText="0.00"
                               GridPane.columnIndex="3" GridPane.rowIndex="2"/>

                    <Label text="Stock" styleClass="field-label" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
                    <TextField fx:id="txtStock" promptText="0"
                               GridPane.columnIndex="1" GridPane.rowIndex="3"/>
                </GridPane>

                <HBox spacing="10">
                    <Button text="Guardar" onAction="#handleGuardar" styleClass="btn-primary"/>
                    <Button text="Actualizar" onAction="#handleActualizar" styleClass="btn-primary"/>
                    <Button text="Eliminar" onAction="#handleEliminar" styleClass="btn-nav-danger"/>
                    <Button text="Limpiar" onAction="#handleLimpiar" styleClass="btn-secondary"/>
                </HBox>
            </VBox>

            <!-- TABLA -->
            <TableView fx:id="tablaVideojuegos" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colId" text="ID" prefWidth="50"/>
                    <TableColumn fx:id="colCodigo" text="Código" prefWidth="90"/>
                    <TableColumn fx:id="colTitulo" text="Título" prefWidth="220"/>
                    <TableColumn fx:id="colPlataforma" text="Plataforma" prefWidth="140"/>
                    <TableColumn fx:id="colCategoria" text="Categoría" prefWidth="120"/>
                    <TableColumn fx:id="colPrecioCosto" text="Costo (Q)" prefWidth="90"/>
                    <TableColumn fx:id="colPrecioVenta" text="Venta (Q)" prefWidth="90"/>
                    <TableColumn fx:id="colStock" text="Stock" prefWidth="70"/>
                </columns>
            </TableView>
        </VBox>
    </center>

</BorderPane>
